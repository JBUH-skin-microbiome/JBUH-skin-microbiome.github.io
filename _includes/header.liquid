<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if site.title %}
        <a class="navbar-brand title font-weight-lighter" href="{{ '/' | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <li class="nav-item {% if page.url == '/' %}active{% endif %}"><a class="nav-link" href="{{ '/' | relative_url }}">Home</a></li>
          <li class="nav-item {% if page.url contains '/research/' %}active{% endif %}"><a class="nav-link" href="{{ '/research/' | relative_url }}">Research</a></li>
          <li class="nav-item {% if page.url contains '/publications/' %}active{% endif %}"><a class="nav-link" href="{{ '/publications/' | relative_url }}">Publications</a></li>
          <li class="nav-item {% if page.url contains '/members/' %}active{% endif %}"><a class="nav-link" href="{{ '/members/' | relative_url }}">Members</a></li>

          {% assign lab_active = false %}
          {% if page.url contains '/gallery/' or page.url contains '/facility/' or page.url contains '/internship/' %}
            {% assign lab_active = true %}
          {% endif %}
          <li class="nav-item dropdown {% if lab_active %}active{% endif %}">
            <a
              class="nav-link dropdown-toggle"
              href="#"
              id="labDropdown"
              role="button"
              data-toggle="dropdown"
              aria-haspopup="true"
              aria-expanded="false"
            >Lab</a>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="labDropdown">
              <a class="dropdown-item {% if page.url contains '/gallery/' %}active{% endif %}" href="{{ '/gallery/' | relative_url }}">Gallery</a>
              <a class="dropdown-item {% if page.url contains '/facility/' %}active{% endif %}" href="{{ '/facility/' | relative_url }}">Facility</a>
              <a class="dropdown-item {% if page.url contains '/internship/' %}active{% endif %}" href="{{ '/internship/' | relative_url }}">Internship</a>
            </div>
          </li>

          <li class="nav-item"><a class="nav-link" href="https://jbuh-skin-microbiome.github.io/lab-handbook/">Lab Resources</a></li>
          <li class="nav-item {% if page.url contains '/contact/' %}active{% endif %}"><a class="nav-link" href="{{ '/contact/' | relative_url }}">Contact</a></li>
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-solid fa-moon"></i>
                <i class="fa-solid fa-sun"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
