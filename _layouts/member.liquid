---
layout: page
---

<article class="member-profile">
  <a class="back-link" href="{{ '/members/' | relative_url }}">← Members</a>
  <div class="member-profile-grid">
    <figure>
      <img src="{{ page.image | relative_url }}" alt="{{ page.name }} 프로필 사진">
    </figure>
    <div>
      <p class="eyebrow">{{ page.group_label }}</p>
      <h2>{{ page.name }}</h2>
      <p class="profile-name-en">{{ page.name_en }}</p>
      <p class="member-role">{{ page.role }}</p>
      {% if page.email %}<p><a href="mailto:{{ page.email }}">{{ page.email }}</a></p>{% endif %}
      {% if page.scholar or page.github or page.blog or page.linkedin %}
        <div class="member-social-links" aria-label="{{ page.name }} 외부 프로필">
          {% if page.scholar %}
            <a href="{{ page.scholar }}" title="Google Scholar" aria-label="Google Scholar" target="_blank" rel="noopener noreferrer">
              <i class="ai ai-google-scholar" aria-hidden="true"></i>
            </a>
          {% endif %}
          {% if page.github %}
            <a href="{{ page.github }}" title="GitHub" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-github" aria-hidden="true"></i>
            </a>
          {% endif %}
          {% if page.blog %}
            <a href="{{ page.blog }}" title="Blog" aria-label="Blog" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-blog" aria-hidden="true"></i>
            </a>
          {% endif %}
          {% if page.linkedin %}
            <a href="{{ page.linkedin }}" title="LinkedIn" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
  {% if content != '' %}<div class="profile-details">{{ content }}</div>{% endif %}
  {% if page.publication_names %}
    {% capture member_publications_path %}member-publications/{{ page.slug }}.html{% endcapture %}
    {% include {{ member_publications_path }} %}
  {% endif %}
</article>
