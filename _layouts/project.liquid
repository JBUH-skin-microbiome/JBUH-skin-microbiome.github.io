---
layout: page
---

<article class="collection-detail">
  <a class="back-link" href="{{ page.kind | prepend: '/' | append: '/' | relative_url }}">← {{ page.kind | capitalize }}</a>

  {% if page.images and page.images.size > 0 %}
    <div class="collection-image-grid collection-image-grid-{{ page.kind }}">
      {% for image in page.images %}
        <figure><img src="{{ image | relative_url }}" alt="{{ page.title }} 사진 {{ forloop.index }}" loading="lazy"></figure>
      {% endfor %}
    </div>
  {% endif %}

  {% if page.details %}
    <section class="collection-details">
      <h2>Equipment</h2>
      <ul>{% for item in page.details %}<li>{{ item }}</li>{% endfor %}</ul>
    </section>
  {% endif %}

  {{ content }}
</article>
